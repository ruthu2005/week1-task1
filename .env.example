# =============================================================
# TaskFlow Backend — Environment Variables Template
# Copy this file to backend/.env and fill in your values.
# Never commit the actual .env file to version control!
# =============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Database
# For SQLite: path to the database file (relative to backend/src)
DB_PATH=./taskflow.db

# CORS — set to your frontend URL in production
CORS_ORIGIN=http://localhost:5173

# Frontend (used in production for CORS)
# CORS_ORIGIN=https://taskflow-capstone.vercel.app
